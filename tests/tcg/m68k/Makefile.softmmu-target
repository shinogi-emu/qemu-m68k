# -*- Mode: makefile -*-
#
# m68k system tests: bare-metal guests on the virt machine, which print on
# its Goldfish TTY (0xff008000) and power off through its control device.
#
# SPDX-License-Identifier: GPL-2.0-or-later

M68K_SYSTEM_SRC = $(SRC_PATH)/tests/tcg/m68k/system
VPATH += $(M68K_SYSTEM_SRC)

TESTS += fpfastdiff fp-fast-chain fp-fast-cw fp-fast-ops

# The fast FPU path must give exactly what the exact path gives: the same
# guest with fast-fpu off and on, every result and FPSR compared bit for bit,
# on the 68040 and on the 68060.  The guest dumps hex on the serial port.  Its
# results sit at 1 MiB, below the 8 MiB stack.
fpfastdiff: fpfastdiff.S
	$(CC) $(EXTRA_CFLAGS) -m68040 -nostdlib \
		-Wl,-m,m68kelf,-e,_start,-Ttext,0x1000,-Tbss,0x100000 $< -o $@

# run-test puts only its first command under timeout, so each later command
# carries its own.
define run-fpfastdiff-cpu
	$(call run-test,$<,$(QEMU) -M virt -cpu $1 -m 16 \
		-global m68k-cpu.fast-fpu=off -kernel $< -monitor none \
		-display none -serial file:$<.$1.exact -no-reboot && \
		timeout -s KILL --foreground $(TIMEOUT) $(QEMU) -M virt -cpu $1 \
		-m 16 -global m68k-cpu.fast-fpu=on -kernel $< -monitor none \
		-display none -serial file:$<.$1.fast -no-reboot && \
		timeout -s KILL --foreground $(TIMEOUT) $(PYTHON) \
		$(M68K_SYSTEM_SRC)/fpfastdiff.py check --cpu $1 \
		$<.$1.exact $<.$1.fast)
endef

run-fpfastdiff: fpfastdiff
	$(call run-fpfastdiff-cpu,m68040)
	$(call run-fpfastdiff-cpu,m68060)

# The transcendentals against mpmath (fporacle.py), with fast-fpu on: the
# fast path computes them on the host's long double, and every function must
# stay within the oracle's 2 ulp.  On the 68040 only: the 68060 sends them to
# its software package.  Needs mpmath, so it is only in TESTS when the Python
# has it.  The guest's results sit at 2 MiB, above the stack.
fporacle-fast: fporacle.S
	$(CC) $(EXTRA_CFLAGS) -m68040 -nostdlib \
		-Wl,-m,m68kelf,-e,_start,-Ttext,0x1000,-Tbss,0x200000 $< -o $@

run-fporacle-fast: fporacle-fast
	$(call run-test,$<,rm -f $<.fast && \
		$(QEMU) -M virt -cpu m68040 -m 16 -global m68k-cpu.fast-fpu=on \
		-kernel $< -monitor none -display none -serial file:$<.fast \
		-no-reboot && \
		timeout -s KILL --foreground $(TIMEOUT) $(PYTHON) \
		$(M68K_SYSTEM_SRC)/fporacle.py check $<.fast)

ifneq ($(shell $(PYTHON) -c 'import mpmath' 2>/dev/null && echo y),)
TESTS += fporacle-fast
endif

# A TB that is not fast must not chain past an FPCR write into a fast TB.
# The guest prints P when it could tell the paths apart and the second pass
# took the exact one, p when there was nothing to tell apart, and s on the
# 68060, where nothing it computes differs between the paths.
fp-fast-chain: fp-fast-chain.S
	$(CC) $(EXTRA_CFLAGS) -m68040 -nostdlib \
		-Wl,-m,m68kelf,-e,_start,-Ttext,0x1000,-Tbss,0x9000 $< -o $@

define run-fp-fast-chain-cpu
	$(call run-test,$<,rm -f $<.out && \
		$(QEMU) -M virt -cpu $1 -m 16 -global m68k-cpu.fast-fpu=$2 \
		-kernel $< -monitor none -display none -serial file:$<.out -no-reboot)
	$(call quiet-command,grep -qx '$3' $<.out,TEST,$< on $1 fast-fpu=$2)
endef

run-fp-fast-chain: fp-fast-chain
	$(call run-fp-fast-chain-cpu,m68040,off,p)
	$(call run-fp-fast-chain-cpu,m68040,on,P)
	$(call run-fp-fast-chain-cpu,m68060,off,s)
	$(call run-fp-fast-chain-cpu,m68060,on,s)

# A guest exception longjmps back into cpu_exec(), which on Windows restores
# the host thread's x87 control word: the fast path must load FPCR's again.
fp-fast-cw: fp-fast-cw.S
	$(CC) $(EXTRA_CFLAGS) -m68040 -nostdlib \
		-Wl,-m,m68kelf,-e,_start,-Ttext,0x1000,-Tbss,0x9000 $< -o $@

define run-fp-fast-cw-cpu
	$(call run-test,$<,rm -f $<.out && \
		$(QEMU) -M virt -cpu $1 -m 16 -global m68k-cpu.fast-fpu=$2 \
		-kernel $< -monitor none -display none -serial file:$<.out -no-reboot)
	$(call quiet-command,test "$$(cat $<.out)" = ESTESTESTEST,TEST,$< on $1 fast-fpu=$2)
endef

run-fp-fast-cw: fp-fast-cw
	$(call run-fp-fast-cw-cpu,m68040,off)
	$(call run-fp-fast-cw-cpu,m68040,on)
	$(call run-fp-fast-cw-cpu,m68060,off)
	$(call run-fp-fast-cw-cpu,m68060,on)

# That the fast path is taken at all: the op listing with fast-fpu on has the
# fast helpers and no ftst or get_fpsr, and with it off the reverse.  The
# property is set with -cpu, which wins over the global that qemu-fast-fpu.sh
# appends, so the off run stays off under that wrapper too.  The 68060 build
# leaves out FScc, which that CPU sends to its software package.
fp-fast-ops: fp-fast-ops.S
	$(CC) $(EXTRA_CFLAGS) -m68040 -nostdlib \
		-Wl,-m,m68kelf,-e,_start,-Ttext,0x1000,-Tbss,0x9000 $< -o $@

fp-fast-ops-060: fp-fast-ops.S
	$(CC) $(EXTRA_CFLAGS) -m68040 -nostdlib -Wa,--defsym,M68060=1 \
		-Wl,-m,m68kelf,-e,_start,-Ttext,0x1000,-Tbss,0x9000 $< -o $@

define run-fp-fast-ops-cpu
	$(call run-test,$2,rm -f $2.on.out $2.on.ops && \
		$(QEMU) -M virt -cpu $1$(COMMA)fast-fpu=on -m 16 -kernel $2 \
		-monitor none -display none -serial file:$2.on.out -no-reboot \
		-d op -D $2.on.ops)
	$(call quiet-command,test "$$(cat $2.on.out)" = P && \
		grep -qw "call ffast_op" $2.on.ops && \
		grep -qw "call ffast_op_raw" $2.on.ops && \
		grep -qw "call ffast_store" $2.on.ops && \
		! grep -qw "call ftst" $2.on.ops && \
		! grep -qw "call get_fpsr" $2.on.ops, \
		TEST,$2 ops on $1 fast-fpu=on)
	$(call run-test,$2,rm -f $2.off.out $2.off.ops && \
		$(QEMU) -M virt -cpu $1$(COMMA)fast-fpu=off -m 16 -kernel $2 \
		-monitor none -display none -serial file:$2.off.out -no-reboot \
		-d op -D $2.off.ops)
	$(call quiet-command,test "$$(cat $2.off.out)" = P && \
		! grep -q "call ffast_" $2.off.ops && \
		grep -qw "call ftst" $2.off.ops && \
		grep -qw "call get_fpsr" $2.off.ops, \
		TEST,$2 ops on $1 fast-fpu=off)
endef

run-fp-fast-ops: fp-fast-ops fp-fast-ops-060
	$(call run-fp-fast-ops-cpu,m68040,fp-fast-ops)
	$(call run-fp-fast-ops-cpu,m68060,fp-fast-ops-060)

# The fast-fpu property's default on each machine and its overrides.  Those
# defaults are what it checks, so under qemu-fast-fpu.sh it runs the binary
# the wrapper names, not the wrapper.
EXTRA_RUNS += run-fast-fpu-prop

run-fast-fpu-prop:
	$(call run-test,fast-fpu-prop,$(SHELL) $(M68K_SYSTEM_SRC)/fast-fpu-prop.sh \
		"$${QEMU_FAST_FPU_BIN:-$(QEMU)}",fast-fpu-prop)

# Wall-clock comparison of the two modes.  Not in TESTS: elapsed time is not
# a pass/fail property on a loaded machine.  Run it by name.
fpbench: fpbench.S
	$(CC) $(EXTRA_CFLAGS) -m68040 -nostdlib \
		-Wl,-m,m68kelf,-e,_start,-Ttext,0x1000,-Tbss,0x9000 $< -o $@

run-fpbench: fpbench
	$(call run-test,$<,/usr/bin/time -o $<.exact.t -f %e $(QEMU) \
		-M virt -cpu m68040 -m 16 -global m68k-cpu.fast-fpu=off \
		-kernel $< -monitor none -display none -serial null -no-reboot && \
		timeout -s KILL --foreground $(TIMEOUT) \
		/usr/bin/time -o $<.fast.t -f %e $(QEMU) \
		-M virt -cpu m68040 -m 16 -global m68k-cpu.fast-fpu=on \
		-kernel $< -monitor none -display none -serial null -no-reboot && \
		echo "exact=$$(cat $<.exact.t) fast=$$(cat $<.fast.t)" \
		"ratio=$$(awk -v e=$$(cat $<.exact.t) -v f=$$(cat $<.fast.t) \
		'BEGIN { printf "%.2f", e / f }')")
